---
// The decorative hexagons behind a section. `speed` is how far each moves with the scroll: the
// sign is the direction. They are purely visual, so they are hidden from assistive technology.
interface Props {
  scene: "hero" | "how";
}

const hexagon = "M60 4 108 32v56L60 116 12 88V32Z";
const layers = {
  hero: [
    { id: "a", speed: 0.55, outline: true, tone: "#5e6ad2", fillOpacity: 0 },
    { id: "b", speed: -0.7, outline: false, tone: "#8e98ff", fillOpacity: 0.5 },
    { id: "c", speed: 0.9, outline: true, tone: "#8e98ff", fillOpacity: 0 },
    { id: "d", speed: -0.7, outline: false, tone: "#5e6ad2", fillOpacity: 0.32 },
  ],
  how: [
    { id: "f", speed: 0.5, outline: true, tone: "#5e6ad2", fillOpacity: 0 },
    { id: "g", speed: -0.55, outline: false, tone: "#8e98ff", fillOpacity: 0.45 },
  ],
} as const;

const { scene } = Astro.props;
---

<div class="parallax-scene" aria-hidden="true">
  {
    layers[scene].map((layer) => (
      <svg class={`plx plx-${layer.id}`} data-parallax={layer.speed} viewBox="0 0 120 120">
        {layer.outline ? (
          <path d={hexagon} fill="none" stroke={layer.tone} stroke-width="4" />
        ) : (
          <path d={hexagon} fill={layer.tone} opacity={layer.fillOpacity} />
        )}
      </svg>
    ))
  }
  {
    scene === "hero" && (
      <svg class="plx plx-e" data-parallax="0.35" viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="52" fill="none" stroke="#8e98ff" stroke-width="2" stroke-dasharray="3 9" />
      </svg>
    )
  }
</div>
