---
// A finding as the results show it, written out: the line of code, the mark under what is wrong and the
// words that go with it. Its look comes from `styles/listing.css`, shared with the real results.
interface Props {
  line: number;
  code: string;
  /** Where the mark starts in `code`, and how many characters it covers. */
  at: number;
  length: number;
  severity: "error" | "warning";
  /** The word for the severity, in the language of the page. */
  label: string;
  message: string;
  hint?: string;
}

const { line, code, at, length, severity, label, message, hint } = Astro.props;
---

<figure class={`finding ${severity}`}>
  <p class="msg"><span class="sev">{label}</span>{message}</p>
  <pre class="listing"><span class="row"><span class="ln">{line}</span>{code.slice(0, at)}<mark>{code.slice(at, at + length)}</mark>{code.slice(at + length)}</span><span class="row"><span class="ln"></span><span class="caret">{" ".repeat(at)}{"^".repeat(length)}</span></span></pre>
  {hint && <p class="hint">{hint}</p>}
</figure>
