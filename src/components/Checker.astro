---
import { type Lang, messages } from "../lib/i18n";
import { withBase } from "../lib/site";
import Editor from "./checker/Editor.astro";
import Results from "./checker/Results.astro";
import Status from "./checker/Status.astro";
import Toolbar from "./checker/Toolbar.astro";

interface Props {
  lang: Lang;
  /** The id of the heading that names this section (it comes in the slot, with the introduction). */
  titleId: string;
}

const { lang, titleId } = Astro.props;
const m = messages[lang];
// Only what the browser script needs to render results.
const client = Object.fromEntries(
  Object.entries(m).filter(([key]) => /^(diag|result|target|coverage)\./.test(key)),
);
---

<section
  id="checker"
  class="checker"
  aria-labelledby={titleId}
  data-view="editor"
  data-messages={JSON.stringify(client)}
  data-base={withBase(import.meta.env.BASE_URL)}
>
  <!-- On a narrow screen the editor and the findings take turns; beside each other, there is nothing to switch. -->
  <div class="views" role="group" aria-label={m["result.viewLabel"]}>
    <button type="button" class="view" id="view-editor" aria-pressed="true">{m["result.viewEditor"]}</button>
    <button type="button" class="view" id="view-problems" aria-pressed="false">{m["result.viewProblems"]}</button>
  </div>
  <div class="bench">
    <div class="frame">
      <Toolbar lang={lang} />
      <Editor lang={lang} />
      <Status lang={lang} />
    </div>
    <p class="privacy">{m["checker.privacy"]}</p>
  </div>
  <Results><slot /></Results>
</section>

<script>
  import "./checker/main";
</script>

<style>
  /* Narrow screens: the editor, then what was found. */
  .checker {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: var(--page);
    margin: 1.5rem auto 0;
  }
  .views {
    display: flex;
    gap: 0.25rem;
  }
  .view {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 560;
    cursor: pointer;
  }
  .view[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 63.99rem) {
    .checker[data-view="editor"] :global(.panel) {
      display: none;
    }
    .checker[data-view="problems"] .bench {
      display: none;
    }
  }
  .bench {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .frame {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--paper-2);
    overflow: hidden;
  }
  .frame:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 5px var(--marker);
  }
  .privacy {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  /* A workbench: the editor takes what the window leaves, the findings sit beside it and scroll on
     their own, so nothing needs a scroll of the page to be seen. */
  @media (min-width: 64rem) {
    .views {
      display: none;
    }
    .checker {
      grid-template-columns: minmax(0, 1fr) minmax(24rem, 30%);
      gap: 2rem;
      height: max(32rem, calc(100dvh - 15rem));
    }
    .bench {
      min-height: 0;
    }
  }
</style>
