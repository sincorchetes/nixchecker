---
import { type Lang, messages } from "../lib/i18n";
import { withBase } from "../lib/site";
import Controls from "./checker/Controls.astro";
import Editor from "./checker/Editor.astro";
import Results from "./checker/Results.astro";

interface Props {
  lang: Lang;
  /** The id of the heading that names this section (it comes in the slot, with the introduction). */
  titleId: string;
}

const { lang, titleId } = Astro.props;
const m = messages[lang];
// Only what the browser script needs to render results.
const client = Object.fromEntries(
  Object.entries(m).filter(([key]) => /^(diag|result|target|coverage)\./.test(key)),
);
---

<section
  id="checker"
  class="checker"
  aria-labelledby={titleId}
  data-messages={JSON.stringify(client)}
  data-base={withBase(import.meta.env.BASE_URL)}
>
  <div class="bench">
    <Controls lang={lang} />
    <Editor lang={lang} />
    <p class="privacy">{m["checker.privacy"]}</p>
  </div>
  <Results><slot /></Results>
</section>

<script>
  import "./checker/main";
</script>

<style>
  /* Narrow screens: the editor, then what was found. */
  .checker {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: var(--page);
    margin: 1.5rem auto 0;
  }
  .bench {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .privacy {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  /* A workbench: the editor takes what the window leaves, the findings sit beside it and scroll on
     their own, so nothing needs a scroll of the page to be seen. */
  @media (min-width: 64rem) {
    .checker {
      grid-template-columns: minmax(0, 1fr) minmax(24rem, 30%);
      gap: 2rem;
      height: max(32rem, calc(100dvh - 14.5rem));
    }
    .bench {
      min-height: 0;
    }
  }
</style>
