---
import { type Lang, messages } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const m = messages[Astro.props.lang];
---

<label for="source">{m["checker.label"]}</label>
<div class="editor">
  <pre id="gutter" class="gutter" aria-hidden="true"></pre>
  <div class="pane">
    <pre id="highlight" class="highlight" aria-hidden="true"></pre>
    <textarea
      id="source"
      wrap="off"
      spellcheck="false"
      autocomplete="off"
      autocapitalize="off"
      placeholder={m["checker.placeholder"]}></textarea>
  </div>
</div>
<p id="cursor" class="cursor"></p>

<style>
  label {
    font-weight: 560;
  }
  .editor {
    display: flex;
    margin-top: 0.5rem;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--paper-2);
    overflow: hidden;
  }
  .editor.dropping {
    border-style: dashed;
    background: var(--marker);
  }
  .editor:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 5px var(--marker);
  }
  .pane {
    position: relative;
    display: flex;
    flex: 1;
    min-width: 0;
  }
  .gutter,
  .highlight,
  textarea {
    margin: 0;
    padding: 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .gutter {
    flex: none;
    min-width: 3rem;
    padding-inline: 0.6rem;
    overflow: hidden;
    text-align: right;
    color: var(--ink-3);
    border-right: 1px solid var(--rule);
    user-select: none;
  }
  .gutter :global(.ln) {
    display: block;
  }
  .gutter :global(.ln.error) {
    color: var(--flag);
    font-weight: 700;
  }
  .gutter :global(.ln.warning) {
    color: var(--warn);
    font-weight: 700;
  }
  textarea {
    display: block;
    flex: 1;
    min-width: 0;
    min-height: 16rem;
    padding-inline: 1rem;
    resize: vertical;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    white-space: pre;
    overflow: auto;
    tab-size: 2;
  }
  /* The colored copy of the text sits right under the text, which is then drawn transparent. */
  .highlight {
    position: absolute;
    inset: 0;
    padding-inline: 1rem;
    overflow: hidden;
    pointer-events: none;
    color: var(--ink);
    white-space: pre;
    tab-size: 2;
  }
  .hl textarea {
    -webkit-text-fill-color: transparent;
    caret-color: var(--ink);
  }
  .hl textarea::placeholder {
    -webkit-text-fill-color: var(--ink-3);
  }
  /* See-through, so the colored text stays readable while selected. */
  .hl textarea::selection {
    background: var(--marker);
  }
  .highlight :global(.tok-comment) {
    color: var(--ink-3);
    font-style: italic;
  }
  .highlight :global(.tok-string) {
    color: var(--ok);
  }
  .highlight :global(.tok-number) {
    color: var(--warn);
  }
  .highlight :global(.tok-keyword) {
    color: var(--ink);
    font-weight: 700;
  }
  .highlight :global(.tok-path) {
    color: var(--link);
  }
  .highlight :global(.mk-error),
  .highlight :global(.mk-warning) {
    text-decoration: underline wavy;
    text-underline-offset: 0.2em;
  }
  .highlight :global(.mk-error) {
    text-decoration-color: var(--flag);
  }
  .highlight :global(.mk-warning) {
    text-decoration-color: var(--warn);
  }
  @media (forced-colors: active) {
    .highlight {
      display: none;
    }
    .hl textarea {
      -webkit-text-fill-color: currentcolor;
    }
  }
  textarea::placeholder {
    color: var(--ink-3);
  }
  .cursor {
    margin: 0.35rem 0 0;
    text-align: right;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    min-height: 1em;
  }
</style>
