---
import { DEFAULT_VERSION, TARGETS, VERSIONS } from "../../lib/catalog";
import { type Lang, messages } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const m = messages[Astro.props.lang];
---

<div class="bar">
  <label class="choice">
    <span>{m["checker.target"]}</span>
    <select id="target">
      <option value="auto">{m["target.auto"]}</option>
      {TARGETS.map((t) => <option value={t}>{m[`target.${t}`]}</option>)}
    </select>
  </label>
  <label class="choice">
    <span>{m["checker.version"]}</span>
    <select id="version" title={m["checker.versionHint"]}>
      {VERSIONS.map((v) => <option value={v} selected={v === DEFAULT_VERSION}>{v}</option>)}
    </select>
  </label>
  <label class="choice remember">
    <input type="checkbox" id="remember" />
    <span>{m["checker.remember"]}</span>
  </label>
  <div class="actions">
    <input type="file" id="file" accept=".nix,text/plain" hidden />
    <button type="button" class="btn" id="open">{m["checker.open"]}</button>
    <button type="button" class="btn" id="export" disabled>{m["checker.export"]}</button>
    <button type="button" class="btn" id="clear">{m["checker.clear"]}</button>
    <button type="button" class="btn" id="example">{m["checker.example"]}</button>
    <button type="button" class="btn primary" id="validate">{m["checker.validate"]}</button>
  </div>
</div>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
  }
  .choice {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  select {
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
  }
  .remember {
    cursor: pointer;
  }
  .remember input {
    accent-color: var(--accent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
