---
import { type Lang, messages } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const m = messages[Astro.props.lang];
---

<!-- What can be done with the text, in the bar on top of the editor. Validate is the last one: the
     button a keyboard user reaches going back from the text. -->
<div class="toolbar">
  <input type="file" id="file" accept=".nix,text/plain" multiple hidden />
  <input type="file" id="folder" hidden />
  <button type="button" class="tool" id="open">{m["checker.open"]}</button>
  <button type="button" class="tool" id="open-folder">{m["checker.openFolder"]}</button>
  <select id="project" class="tool project" aria-label={m["checker.project"]} hidden></select>
  <button type="button" class="tool" id="export" disabled>{m["checker.export"]}</button>
  <button type="button" class="tool" id="clear">{m["checker.clear"]}</button>
  <button type="button" class="tool" id="example">{m["checker.example"]}</button>
  <!-- Where the validation stands, always in sight, beside the button that asks for it. The state is for the
       eyes: the results are what is announced. -->
  <div class="run">
    <p id="state" class="state" aria-hidden="true"></p>
    <button type="button" class="tool primary" id="validate">{m["checker.validate"]}</button>
  </div>
</div>
<div id="undo" class="undo" hidden role="status">
  <span>{m["checker.replaced"]}</span>
  <button type="button" id="undo-button">{m["checker.undo"]}</button>
</div>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    align-items: center;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .tool {
    padding: 0.3rem 0.7rem;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 560;
    cursor: pointer;
    transition: background var(--motion);
  }
  .tool:hover:not(:disabled) {
    background: var(--marker);
    color: var(--on-marker);
  }
  .project {
    max-width: 14rem;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .project[hidden] {
    display: none;
  }
  .tool:disabled {
    color: var(--ink-3);
    cursor: default;
  }
  .run {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-left: auto;
  }
  /* A narrow screen puts them on a row of their own: the state at one end, the button at the other. */
  @media (max-width: 40rem) {
    .run {
      flex-basis: 100%;
      justify-content: space-between;
    }
  }
  .state {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 560;
  }
  .state[data-tone="bad"] {
    color: var(--flag);
  }
  .state[data-tone="good"] {
    color: var(--ok);
  }
  .state[data-tone="busy"] {
    color: var(--ink-2);
  }
  .undo {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    background: var(--marker);
    color: var(--on-marker);
    font-size: 0.8125rem;
  }
  .undo[hidden] {
    display: none;
  }
  .undo button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }
  /* Run, as an editor has it: at the far end of the bar. */
  .tool.primary {
    background: var(--ink);
    color: var(--paper);
  }
  .tool.primary:hover:not(:disabled) {
    background: var(--marker);
    color: var(--on-marker);
  }
</style>
