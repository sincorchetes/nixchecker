---
import Base from "../layouts/Base.astro";
import { type Lang, messages } from "../lib/i18n";
import Checker from "./Checker.astro";
import Layers from "./Layers.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const m = messages[lang];
const features = ["docs", "local", "hints"] as const;
const notes = ["note1", "note2", "note3"] as const;
---

<Base lang={lang}>
  <main>
    <section class="hero">
      <Layers scene="hero" />
      <div class="hero-content" data-parallax="-0.14">
        <p class="eyebrow"><span></span>{m["hero.eyebrow"]}</p>
        <h1>{m["hero.titleA"]}<br /><em>{m["hero.titleB"]}</em></h1>
        <p class="hero-lead">{m["hero.subtitle"]}</p>
        <a class="primary-button" href="#validador">{m["hero.cta"]} <span aria-hidden="true">↓</span></a>
        <div class="hero-notes">
          {notes.map((key) => <span>✓ {m[`hero.${key}`]}</span>)}
        </div>
      </div>
    </section>

    <section id="validador" class="validator-section" aria-labelledby="validator-title">
      <div class="validator-inner">
        <div class="section-heading">
          <span class="kicker">{m["validator.kicker"]}</span>
          <h2 id="validator-title">{m["validator.title"]}</h2>
          <p>{m["validator.lead"]}</p>
        </div>
        <Checker lang={lang} />
      </div>
    </section>

    <section id="como-funciona" class="how-section" aria-labelledby="how-title">
      <Layers scene="how" />
      <div class="section-heading centered">
        <span class="kicker">{m["features.kicker"]}</span>
        <h2 id="how-title">{m["features.title"]}</h2>
        <p>{m["features.lead"]}</p>
      </div>
      <div class="feature-grid">
        {
          features.map((key, n) => (
            <article>
              <span class="feature-number">{`0${n + 1}`}</span>
              <h3>{m[`features.${key}.title`]}</h3>
              <p class="feature-body">{m[`features.${key}.body`]}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="final-cta">
      <div>
        <span class="kicker">{m["cta.kicker"]}</span>
        <h2>{m["cta.title1"]}<br />{m["cta.title2"]}</h2>
      </div>
      <a class="primary-button" href="#validador">{m["cta.button"]} <span aria-hidden="true">↑</span></a>
    </section>
  </main>
</Base>

<script>
  import "./parallax";
</script>
