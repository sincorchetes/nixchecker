---
import Base from "../layouts/Base.astro";
import { format, type Lang, messages } from "../lib/i18n";
import Checker from "./Checker.astro";
import Specimen from "./Specimen.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const m = messages[lang];
const tell = (key: keyof typeof m, params: Record<string, string>) => format(m[key], params);

// The three findings the page shows as examples: a typo, a value of the wrong type and a renamed option.
const typo = "services.nginx.enabel";
const wrongType = "networking.firewall.enable";
const renamed = "services.xserver.displayManager.gdm.enable";
const features = ["docs", "local", "hints"] as const;
---

<Base lang={lang}>
  <main>
    <h1 id="intro-title" class="headline">{m["hero.title"]}</h1>
    <Checker lang={lang} titleId="intro-title">
      <div class="intro">
        <p class="lead">{m["hero.subtitle"]}</p>
        <Specimen
          line={14}
          code={`  ${typo} = true;`}
          at={2}
          length={typo.length}
          severity="error"
          label={m["result.error"]}
          message={tell("diag.unknown-option", { path: typo })}
          hint={tell("result.suggest", { suggestion: "services.nginx.enable" })}
        />
      </div>
    </Checker>

    <section id="como-funciona" class="how" aria-labelledby="how-title">
      <div class="how-intro">
        <h2 id="how-title">{m["features.title"]}</h2>
        <p>{m["features.lead"]}</p>
      </div>
      <dl class="how-notes">
        {
          features.map((key) => (
            <div class="how-note">
              <dt>{m[`features.${key}.title`]}</dt>
              <dd>
                <p>{m[`features.${key}.body`]}</p>
                {key === "docs" && (
                  <Specimen
                    line={6}
                    code={`  ${wrongType} = "yes";`}
                    at={2}
                    length={wrongType.length}
                    severity="error"
                    label={m["result.error"]}
                    message={tell("diag.type-mismatch", { path: wrongType, expected: "bool", got: "str" })}
                  />
                )}
                {key === "hints" && (
                  <Specimen
                    line={3}
                    code={`  ${renamed} = true;`}
                    at={2}
                    length={renamed.length}
                    severity="warning"
                    label={m["result.warning"]}
                    message={tell("diag.deprecated", {
                      path: renamed,
                      replacement: "services.displayManager.gdm.enable",
                    })}
                  />
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>
</Base>
