---
import "../styles/global.css";
import { type Lang, messages } from "../lib/i18n";
import { withBase } from "../lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const m = messages[lang];
const other: Lang = lang === "es" ? "en" : "es";
const base = import.meta.env.BASE_URL;
const href = (l: Lang) => withBase(base, l === "es" ? "" : "en/");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{m["site.title"]}</title>
    <meta name="description" content={m["site.description"]} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={m["site.title"]} />
    <meta property="og:description" content={m["site.description"]} />
    <link rel="alternate" hreflang="es" href={href("es")} />
    <link rel="alternate" hreflang="en" href={href("en")} />
    <link rel="alternate" hreflang="x-default" href={href("es")} />
    <link rel="icon" href={withBase(base, "favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <header class="wrap top">
      <a class="brand" href={href(lang)}>nix<span>checker</span></a>
      <nav>
        <a href="https://github.com/sincorchetes/nixchecker" rel="noopener">{m["nav.source"]}</a>
        <a class="pill" href={href(other)} hreflang={other} lang={other} aria-label={m["nav.languageLabel"]}>
          {m["nav.language"]}
        </a>
      </nav>
    </header>

    <slot />

    <footer class="wrap foot">
      <p>{m["footer.unofficial"]}</p>
      <p>{m["footer.ai"]}</p>
      <p>{m["footer.license"]}</p>
    </footer>
  </body>
</html>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand span {
    color: var(--accent-light);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9rem;
  }
  nav a {
    color: var(--text-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
  }
  .pill {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .foot {
    padding-block: 3rem 2.5rem;
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-size: 0.85rem;
  }
  .foot p {
    margin: 0.25rem 0;
  }
</style>
