---
import "../styles/global.css";
import "../styles/landing/chrome.css";
import "../styles/landing/hero.css";
import "../styles/landing/sections.css";
import { type Lang, messages } from "../lib/i18n";
import { withBase } from "../lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const m = messages[lang];
const other: Lang = lang === "es" ? "en" : "es";
const base = import.meta.env.BASE_URL;
const path = (l: Lang) => withBase(base, l === "es" ? "" : "en/");
// Absolute, as search engines expect for canonical and alternate links.
const source = "https://github.com/sincorchetes/nixchecker";
const href = (l: Lang) => new URL(path(l), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{m["site.title"]}</title>
    <meta name="description" content={m["site.description"]} />
    <meta name="robots" content="index, follow" />
    <!-- Pages cannot send headers, so the policy rides in a meta tag. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'"
    />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:title" content={m["site.title"]} />
    <meta property="og:description" content={m["site.description"]} />
    <meta property="og:url" content={href(lang)} />
    <link rel="canonical" href={href(lang)} />
    <link rel="alternate" hreflang="es" href={href("es")} />
    <link rel="alternate" hreflang="en" href={href("en")} />
    <link rel="alternate" hreflang="x-default" href={href("es")} />
    <link rel="icon" href={withBase(base, "favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={path(lang)}>nix<span>checker</span></a>
      <nav aria-label={m["nav.main"]}>
        <a href="#validador">{m["nav.validator"]}</a>
        <a href="#como-funciona">{m["nav.how"]}</a>
      </nav>
      <div class="header-actions">
        <a class="lang-switch" href={path(other)} hreflang={other} lang={other} title={m["nav.languageLabel"]}>
          {m["nav.language"]}<span class="sr-only"> · {m["nav.languageLabel"]}</span>
        </a>
        <a class="header-cta" href="#validador">{m["nav.cta"]} <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <aside class="unofficial-bar" aria-label={m["bar.label"]}>{m["bar.unofficial"]}</aside>

    <slot />

    <footer class="site-footer">
      <a class="brand" href={path(lang)}>nix<span>checker</span></a>
      <p>{m["footer.tagline"]}</p>
      <p class="legal">{m["footer.unofficial"]}</p>
      <p class="legal">
        {m["footer.license"]} · <a class="footer-link" href={source} rel="noopener">{m["nav.source"]}</a> ·
        <a class="footer-link" href="https://sincorchetes.tech" rel="author noopener">sincorchetes.tech</a>
      </p>
      <p class="legal">{m["footer.ai"]}</p>
    </footer>
  </body>
</html>

