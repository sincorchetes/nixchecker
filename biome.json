{
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!.astro",
      "!.devenv",
      "!**/*.astro",
      "!bun.lock",
      "!public/catalog",
      "!tools/local/schemas"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    }
  ]
}
